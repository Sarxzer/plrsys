# ───────────────────────────────────────────────────────────────
# APPLICATION CONFIG
# ───────────────────────────────────────────────────────────────
APP_NAME=Innerspace
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# ───────────────────────────────────────────────────────────────
# DATABASE CONFIG
# ───────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_DATABASE=innerspace-dev
DB_USERNAME=innerspace-dev
DB_PASSWORD=secret


# ───────────────────────────────────────────────────────────────
# MAILER CONFIG
# ───────────────────────────────────────────────────────────────
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USERNAME=mail@example.com
SMTP_PASSWORD=secret
SMTP_ENCRYPTION=tls


# ───────────────────────────────────────────────────────────────
# OTHER CONFIG
# ───────────────────────────────────────────────────────────────
BOT_API_TOKEN=some_long_random_secret

DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret
DISCORD_REDIRECT_URI=https://innerspace.sarxzer.xyz/settings/discord/callback
